{
  "compilerOptions": {
    "jsx": "preserve",
    "baseUrl": "./",
    // Added the paths mapping for @Obsidian aliases.
    // Remove or comment out the "paths" field below if this change causes issues.
    "paths": {
      "@Obsidian/Utility/*": ["Framework/Utility/*"],
      "@Obsidian/Controls/*": ["Framework/Controls/*"],
      "@Obsidian/ViewModels/*": ["Framework/ViewModels/*"],
      "@Obsidian/Types": ["Framework/Types/index.d.ts"]
    },
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "removeComments": true,
    "allowUnreachableCode": false,
    "forceConsistentCasingInFileNames": true,
    "target": "ES2016",
    "moduleResolution": "Node"
  }
}
